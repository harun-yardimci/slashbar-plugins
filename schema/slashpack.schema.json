{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slashbar.dev/schemas/slashpack-1.json",
  "title": "SlashPack plugin manifest (schema 1)",
  "type": "object",
  "required": ["schema", "id", "name", "author", "version", "description", "commands"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$",
      "maxLength": 80,
      "description": "Reverse-DNS identifier, e.g. dev.yourname.git-helpers"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "author": { "type": "string", "minLength": 1, "maxLength": 60 },
    "version": { "type": "string", "pattern": "^\\d+(\\.\\d+){0,2}$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 200 },
    "icon": { "type": "string", "maxLength": 80 },
    "homepage": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 200
    },
    "minAppVersion": { "type": "string", "pattern": "^\\d+(\\.\\d+){0,2}$" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "body"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 60 },
          "name": { "type": "string", "minLength": 1, "maxLength": 60 },
          "kind": { "enum": ["ai", "shell", "url"] },
          "body": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "description": { "type": "string", "maxLength": 200 },
          "icon": { "type": "string", "maxLength": 80 },
          "keywords": {
            "type": "array",
            "maxItems": 15,
            "items": { "type": "string", "maxLength": 30 }
          }
        }
      }
    }
  }
}
