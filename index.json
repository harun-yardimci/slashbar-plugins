{
  "schema": 1,
  "plugins": [
    {
      "schema": 1,
      "id": "dev.slashbar.dev-search",
      "name": "Dev Search",
      "author": "Slashbar",
      "version": "1.0.0",
      "description": "Search the text on developer sites",
      "icon": "magnifyingglass.circle",
      "homepage": "https://github.com/harun-yardimci/slashbar-plugins",
      "commands": [
        {
          "id": "mdn",
          "name": "Search MDN",
          "kind": "url",
          "body": "https://developer.mozilla.org/en-US/search?q={q}",
          "description": "Web platform docs on MDN.",
          "keywords": [
            "mdn",
            "javascript",
            "css",
            "html",
            "docs"
          ]
        },
        {
          "id": "caniuse",
          "name": "Can I Use…",
          "kind": "url",
          "body": "https://caniuse.com/?search={q}",
          "description": "Browser support tables.",
          "keywords": [
            "caniuse",
            "browser",
            "support",
            "css"
          ]
        },
        {
          "id": "stackoverflow",
          "name": "Search Stack Overflow",
          "kind": "url",
          "body": "https://stackoverflow.com/search?q={q}",
          "description": "Questions and answers.",
          "keywords": [
            "stackoverflow",
            "so",
            "error",
            "question"
          ]
        },
        {
          "id": "npm",
          "name": "Search npm",
          "kind": "url",
          "body": "https://www.npmjs.com/search?q={q}",
          "description": "Node.js packages.",
          "keywords": [
            "npm",
            "node",
            "package",
            "javascript"
          ]
        },
        {
          "id": "github-code",
          "name": "Search GitHub Code",
          "kind": "url",
          "body": "https://github.com/search?q={q}&type=code",
          "description": "Real-world usage examples in open source.",
          "keywords": [
            "github",
            "code",
            "example",
            "usage"
          ]
        }
      ]
    },
    {
      "schema": 1,
      "id": "dev.slashbar.fun-text",
      "name": "Fun Text",
      "author": "Slashbar",
      "version": "1.0.0",
      "description": "Playful text transforms — AI and local shell mixed",
      "icon": "face.smiling",
      "homepage": "https://github.com/harun-yardimci/slashbar-plugins",
      "commands": [
        {
          "id": "eli5",
          "name": "Explain Like I'm Five",
          "kind": "ai",
          "body": "Explain the following to a five-year-old, using simple words and a friendly analogy. Keep it short. Answer in the same language as the input.",
          "description": "Simplify anything down to child level.",
          "keywords": [
            "eli5",
            "explain",
            "simple",
            "basit",
            "açıkla"
          ]
        },
        {
          "id": "emojify",
          "name": "Emojify",
          "kind": "ai",
          "body": "Rewrite the following text, sprinkling in fitting emojis generously. Keep the meaning intact. Return only the rewritten text.",
          "description": "Same text, now with emojis.",
          "keywords": [
            "emoji",
            "fun"
          ]
        },
        {
          "id": "code-roast",
          "name": "Roast My Code",
          "kind": "ai",
          "body": "Roast the following code: point out its problems with humor, then end with two genuinely useful improvement suggestions.",
          "description": "Humorous but useful code review.",
          "keywords": [
            "roast",
            "review",
            "fun",
            "code"
          ]
        },
        {
          "id": "rot13",
          "name": "ROT13",
          "kind": "shell",
          "body": "tr 'A-Za-z' 'N-ZA-Mn-za-m'",
          "description": "Classic letter-rotation cipher (run twice to decode).",
          "keywords": [
            "rot13",
            "cipher",
            "encode",
            "decode"
          ]
        },
        {
          "id": "mock-case",
          "name": "mOcKiNg cAsE",
          "kind": "shell",
          "body": "awk 'BEGIN{FS=\"\"}{for(i=1;i<=NF;i++){c=$i; if(i%2)printf \"%s\",tolower(c); else printf \"%s\",toupper(c)} print \"\"}'",
          "description": "aLtErNaTiNg cApS, meme style.",
          "keywords": [
            "mock",
            "spongebob",
            "meme",
            "case"
          ]
        }
      ]
    },
    {
      "schema": 1,
      "id": "dev.slashbar.git-helpers",
      "name": "Git Helpers",
      "author": "Slashbar",
      "version": "1.0.0",
      "description": "Actions for everyday git workflows",
      "icon": "arrow.triangle.branch",
      "homepage": "https://github.com/harun-yardimci/slashbar-plugins",
      "commands": [
        {
          "id": "conventional-commit",
          "name": "Conventional Commit",
          "kind": "ai",
          "body": "Rewrite the following change description as a conventional commit message (type(scope): subject, then an optional body). Return only the commit message.",
          "description": "Turn a change description into a conventional commit message.",
          "keywords": [
            "git",
            "commit",
            "conventional"
          ]
        },
        {
          "id": "explain-diff",
          "name": "Explain Diff",
          "kind": "ai",
          "body": "Explain what the following diff changes and why it might have been made. Be concise.",
          "description": "Plain-language summary of a copied diff.",
          "keywords": [
            "git",
            "diff",
            "review"
          ]
        },
        {
          "id": "pr-search",
          "name": "Search Pull Requests",
          "kind": "url",
          "body": "https://github.com/pulls?q={q}",
          "description": "Search GitHub pull requests for the text.",
          "keywords": [
            "github",
            "pr",
            "pull request"
          ]
        }
      ]
    },
    {
      "schema": 1,
      "id": "dev.slashbar.mac-alerts",
      "name": "Mac Alerts",
      "author": "Slashbar",
      "version": "1.0.0",
      "description": "Turn text into macOS notifications and speech",
      "icon": "bell.badge",
      "homepage": "https://github.com/harun-yardimci/slashbar-plugins",
      "commands": [
        {
          "id": "notify",
          "name": "Show as Notification",
          "kind": "shell",
          "body": "t=$(head -c 200); osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title \"Slashbar\"' -e 'end run' \"$t\"",
          "description": "Pop the text as a macOS notification.",
          "icon": "bell",
          "keywords": [
            "notification",
            "alert",
            "bildirim",
            "uyarı"
          ]
        },
        {
          "id": "speak",
          "name": "Speak Text",
          "kind": "shell",
          "body": "head -c 400 | say",
          "description": "Read the text aloud with the system voice.",
          "icon": "speaker.wave.2",
          "keywords": [
            "say",
            "speech",
            "voice",
            "sesli",
            "oku"
          ]
        }
      ]
    }
  ]
}
